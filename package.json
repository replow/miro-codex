{
  "name": "miro-photo-gallery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "pnpm generate:photo-manifest && node scripts/build-static.mjs",
    "generate:photo-manifest": "node scripts/generate-photo-manifest.mjs",
    "dev": "pnpm build && python3 -m http.server 4321 --directory dist"
  }
}
