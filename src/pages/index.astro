---
import { getPhotoPaths } from '@lib/photos';
import { defaultLocale } from '@/i18n';

interface Props {
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;
const photos = await getPhotoPaths();
const language = locale === 'zh' ? 'zh-CN' : locale;
const copy = {
  zh: { title: '图库', random: '随机看一张', count: '张图片', empty: '图库还没有图片', hint: '喜欢的瞬间，会慢慢收集在这里。' },
  en: {
    title: 'Photo gallery',
    random: 'Surprise me',
    count: 'photos',
    empty: 'No photos yet',
    hint: 'Favorite moments will find their way here.',
  },
  ja: {
    title: 'フォトギャラリー',
    random: 'ランダムに見る',
    count: '枚の写真',
    empty: 'まだ写真がありません',
    hint: 'お気に入りの瞬間を、ここに集めていきます。',
  },
  ko: {
    title: '사진 갤러리',
    random: '사진 무작위 보기',
    count: '장의 사진',
    empty: '아직 사진이 없습니다',
    hint: '좋아하는 순간을 이곳에 모아 둘게요.',
  },
} as const;
const text = copy[locale as keyof typeof copy] ?? copy.zh;
const pageTitle = `${text.title} · Miro`;
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={`${text.title} · Miro`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Miro home">miro<span>.</span></a>
        {photos.length > 0 && (
          <a class="random-link" href="/api">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" /></svg>
            {text.random}
          </a>
        )}
      </header>

      <main>
        <div class="gallery-heading">
          <h1>{text.title}</h1>
          <p>{photos.length} {text.count}</p>
        </div>

        {photos.length > 0 ? (
          <div class="photo-grid" aria-label={text.title}>
            {photos.map((photo, index) => (
              <a class="photo-card" href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={photo.alt}>
                <img
                  src={photo.src}
                  alt={photo.alt}
                  loading={index < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </a>
            ))}
          </div>
        ) : (
          <section class="empty-state" aria-label={text.empty}>
            <div class="empty-icon" aria-hidden="true">
              <svg viewBox="0 0 52 52" fill="none">
                <rect x="7.5" y="7.5" width="37" height="37" rx="10.5" />
                <circle cx="19.5" cy="19.5" r="3" />
                <path d="m9 37 11-11 8 8 5-5 10 10" />
              </svg>
            </div>
            <h2>{text.empty}</h2>
            <p>{text.hint}</p>
          </section>
        )}
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans SC', 'PingFang SC',
      'Microsoft YaHei', sans-serif;
    color: #28262b;
    background: #fff;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  * { box-sizing: border-box; }
  html { min-width: 320px; min-height: 100%; background: #fff; }
  body { min-width: 320px; min-height: 100vh; margin: 0; background: #fff; }
  a { color: inherit; }

  .page-shell {
    width: min(100% - 64px, 1320px);
    min-height: 100vh;
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    height: 84px;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #f0eef0;
  }

  .wordmark {
    font-size: 24px;
    font-weight: 750;
    letter-spacing: -1.4px;
    text-decoration: none;
  }

  .wordmark span { color: #f05d79; }

  .random-link {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    gap: 8px;
    padding: 0 16px;
    border: 1px solid #eee9eb;
    border-radius: 999px;
    background: #fff;
    color: #302d32;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .random-link svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.6; }
  .random-link:hover { transform: translateY(-1px); border-color: #f05d79; color: #e64c6b; }
  .random-link:focus-visible, .photo-card:focus-visible, .wordmark:focus-visible { outline: 3px solid #f05d79; outline-offset: 4px; }

  main { padding: 43px 0 72px; }

  .gallery-heading { display: flex; align-items: baseline; gap: 15px; margin-bottom: 26px; }
  .gallery-heading h1 { margin: 0; font-size: clamp(34px, 4vw, 42px); font-weight: 720; letter-spacing: -1.7px; line-height: 1.2; }
  .gallery-heading p { margin: 0; color: #99959b; font-size: 14px; }

  .photo-grid { columns: 3; column-gap: 16px; }
  .photo-card {
    display: inline-block;
    width: 100%;
    margin: 0 0 16px;
    overflow: hidden;
    break-inside: avoid;
    border-radius: 12px;
    background: #f5f4f5;
    vertical-align: top;
  }
  .photo-card img { display: block; width: 100%; height: auto; transition: transform 220ms ease; }
  .photo-card:hover img { transform: scale(1.025); }

  .empty-state {
    display: flex;
    min-height: 390px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px 16px 58px;
    text-align: center;
  }
  .empty-icon { display: grid; width: 68px; height: 68px; place-items: center; margin-bottom: 19px; border-radius: 21px; background: #fff1f3; color: #ed6078; }
  .empty-icon svg { width: 42px; height: 42px; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.6; }
  .empty-icon rect { stroke: currentColor; }
  .empty-icon circle { fill: currentColor; stroke: none; }
  .empty-icon path { stroke: currentColor; }
  .empty-state h2 { margin: 0; font-size: 18px; font-weight: 650; letter-spacing: -.25px; }
  .empty-state p { margin: 9px 0 0; color: #969198; font-size: 14px; }

  @media (max-width: 760px) {
    .page-shell { width: min(100% - 40px, 620px); }
    .site-header { height: 72px; }
    main { padding-top: 34px; }
    .photo-grid { columns: 2; column-gap: 12px; }
    .photo-card { margin-bottom: 12px; border-radius: 10px; }
  }

  @media (max-width: 420px) {
    .page-shell { width: calc(100% - 32px); }
    .site-header { height: 66px; }
    .wordmark { font-size: 22px; }
    .random-link { min-height: 38px; gap: 6px; padding-inline: 12px; font-size: 13px; }
    main { padding-top: 29px; }
    .gallery-heading { gap: 10px; margin-bottom: 19px; }
    .gallery-heading h1 { font-size: 32px; }
    .photo-grid { columns: 2; column-gap: 9px; }
    .photo-card { margin-bottom: 9px; border-radius: 9px; }
    .empty-state { min-height: 340px; padding-bottom: 44px; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
  }
</style>
