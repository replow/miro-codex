---
import Footer from '@components/layout/Footer.astro';
import PhotoGallery from '@components/photo/PhotoGallery.astro';
import { seoConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import { getPhotoPaths } from '@lib/photos';
import { defaultLocale } from '@/i18n';

interface Props {
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;
const photos = await getPhotoPaths();
---

<Layout locale={locale} title={seoConfig.title}>
  <div class="gallery-home">
    <PhotoGallery photos={photos} locale={locale} />
    <Footer showStats={false} className="mt-10" />
  </div>
</Layout>

<style>
  .gallery-home {
    width: min(100%, 1280px);
    margin-inline: auto;
    padding: 7rem 2rem 2rem;
  }

  :global(body:has(.gallery-home) #site-header) {
    color: hsl(var(--foreground));
    background: hsl(var(--background) / 0.92);
    backdrop-filter: blur(16px);
    text-shadow: none;
  }

  @media (max-width: 640px) {
    .gallery-home {
      padding: 5.5rem 1rem 1rem;
    }
  }
</style>
