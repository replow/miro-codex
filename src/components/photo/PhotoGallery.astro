---
import type { Photo } from '@lib/photos';

interface Props {
  photos: Photo[];
  locale: string;
}

const { photos, locale } = Astro.props;
const labels = {
  zh: { title: '图库', random: '随机看一张', count: '张图片', empty: '图库还没有图片', hint: '新的风景，很快就会出现在这里。' },
  en: {
    title: 'Photo gallery',
    random: 'Random photo',
    count: 'photos',
    empty: 'No photos yet',
    hint: 'New views will appear here soon.',
  },
  ja: {
    title: 'フォトギャラリー',
    random: 'ランダムに見る',
    count: '枚の写真',
    empty: 'まだ写真がありません',
    hint: '新しい景色がまもなくここに登場します。',
  },
  ko: {
    title: '사진 갤러리',
    random: '사진 무작위 보기',
    count: '장의 사진',
    empty: '아직 사진이 없습니다',
    hint: '새로운 풍경이 곧 이곳에 나타납니다.',
  },
} as const;
const copy = labels[locale as keyof typeof labels] ?? labels.zh;
---

<section class="photo-gallery" aria-labelledby="photo-gallery-title">
  <header class="photo-gallery-header">
    <div>
      <h1 id="photo-gallery-title">{copy.title}</h1>
      <p>{photos.length} {copy.count}</p>
    </div>
    {photos.length > 0 && (
      <a href={photos[0].src} class="photo-gallery-random" data-random-photo target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">↗</span> {copy.random}
      </a>
    )}
  </header>

  {photos.length > 0 ? (
    <div class="photo-gallery-grid">
      {photos.map((photo, index) => (
        <a class="photo-gallery-item" href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={photo.alt}>
          <img src={photo.src} alt={photo.alt} loading={index < 4 ? 'eager' : 'lazy'} decoding="async" />
          <span class="photo-gallery-caption">{photo.alt}</span>
        </a>
      ))}
    </div>
  ) : (
    <div class="photo-gallery-empty">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="4" />
        <circle cx="8" cy="8" r="1.5" />
        <path d="m3 17 5-5 4 4 3-3 6 6" />
      </svg>
      <h2>{copy.empty}</h2>
      <p>{copy.hint}</p>
    </div>
  )}
</section>

<script>
  function setupRandomPhoto() {
    const button = document.querySelector<HTMLAnchorElement>('[data-random-photo]');
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.photo-gallery-item'));
    if (!button || links.length === 0 || button.dataset.ready) return;
    button.dataset.ready = 'true';
    button.addEventListener('click', () => {
      button.href = links[Math.floor(Math.random() * links.length)].href;
    });
  }

  setupRandomPhoto();
  document.addEventListener('astro:page-load', setupRandomPhoto);
</script>

<style>
  .photo-gallery-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .photo-gallery-header h1 {
    margin: 0;
    color: hsl(var(--foreground));
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .photo-gallery-header p {
    margin: 0.5rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
  }

  .photo-gallery-random {
    flex: none;
    padding: 0.8rem 1.1rem;
    border-radius: 999px;
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 180ms ease;
  }

  .photo-gallery-random:hover {
    opacity: 0.85;
  }

  .photo-gallery-grid {
    columns: 3;
    column-gap: 1rem;
  }

  .photo-gallery-item {
    position: relative;
    display: inline-block;
    width: 100%;
    margin-bottom: 1rem;
    overflow: hidden;
    break-inside: avoid;
    border-radius: 1rem;
    background: hsl(var(--muted));
    vertical-align: top;
  }

  .photo-gallery-item img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 250ms ease;
  }

  .photo-gallery-caption {
    position: absolute;
    inset: auto 0 0;
    padding: 2rem 1rem 1rem;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.65));
    color: white;
    opacity: 0;
    overflow-wrap: anywhere;
    transition: opacity 180ms ease;
  }

  .photo-gallery-item:hover img {
    transform: scale(1.025);
  }

  .photo-gallery-item:hover .photo-gallery-caption,
  .photo-gallery-item:focus-visible .photo-gallery-caption {
    opacity: 1;
  }

  .photo-gallery-item:focus-visible,
  .photo-gallery-random:focus-visible {
    outline: 3px solid hsl(var(--primary));
    outline-offset: 4px;
  }

  .photo-gallery-empty {
    display: flex;
    min-height: 360px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    border: 1px dashed hsl(var(--border));
    border-radius: 1.5rem;
    background: hsl(var(--card) / 0.7);
    color: hsl(var(--muted-foreground));
    text-align: center;
  }

  .photo-gallery-empty h2 {
    margin: 1.25rem 0 0.5rem;
    color: hsl(var(--foreground));
    font-size: 1.1rem;
    font-weight: 600;
  }

  .photo-gallery-empty p {
    margin: 0;
    font-size: 0.9rem;
  }

  @media (max-width: 767px) {
    .photo-gallery-grid { columns: 2; column-gap: 0.75rem; }
    .photo-gallery-item { margin-bottom: 0.75rem; }
  }

  @media (max-width: 420px) {
    .photo-gallery-grid { columns: 1; }
    .photo-gallery-random { padding: 0.7rem 0.9rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-gallery-item img,
    .photo-gallery-caption,
    .photo-gallery-random { transition: none; }
  }
</style>
